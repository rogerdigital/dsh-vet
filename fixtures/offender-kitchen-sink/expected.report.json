        {
          "file": "index.js",
          "line": 7,
          "snippet": "const who = process.env.HOME",
          "note": "reads process.env; fetch in index.js:12 is statically reachable from here"
        }
      ],
      "remediation": "Keep secret reads and network clients in separate modules, or document the intended data flow for each endpoint.",
      "references": [
        "https://github.com/rogerdigital/dsh-vet/blob/main/docs/rules/egress.secret-adjacent.md"
      ]
    },
    {
